{
  "name": "care-plan-frontend",
  "description": "Application de gestion médicale intelligente pour les établissements de santé",
  "private": true,
  "version": "0.1.0",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:unit:ui": "vitest tests/unit --ui",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/reports"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@radix-ui/react-label": "^2.1.4",
    "@types/react-big-calendar": "^1.16.1",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^15.8.0",
    "joi": "^17.13.3",
    "lucide-react": "^0.331.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.18.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.58.0",
    "react-router": "^7.5.3",
    "react-toastify": "^11.0.5",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@graphql-codegen/typescript-resolvers": "^4.0.3",
    "@playwright/test": "^1.42.1",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^27.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.4.18",
    "vitest": "^3.2.4"
  }
}
